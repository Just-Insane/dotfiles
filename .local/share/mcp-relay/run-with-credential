#!/bin/zsh
set -eu

kind="$1"
shift

case "$kind" in
  digitalocean)
    config="$HOME/Library/Application Support/doctl/config.yaml"
    token=$(/usr/bin/awk -F ': ' '/^access-token:/ { print $2; exit }' "$config")
    if [[ -z "$token" ]]; then
      print -u2 "No DigitalOcean token found. Run: doctl auth init"
      exit 78
    fi
    exec /usr/bin/env DIGITALOCEAN_API_TOKEN="$token" "$@"
    ;;
  hetzner)
    token=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-hetzner-hcloud-token -w 2>/dev/null) || {
      print -u2 "No Hetzner token found in Keychain service mcp-hetzner-hcloud-token"
      exit 78
    }
    gateway_ca="$HOME/.local/share/cloudflare/installed_cert.pem"
    if [[ ! -r "$gateway_ca" ]]; then
      print -u2 "Cloudflare Gateway CA is not readable: $gateway_ca"
      exit 78
    fi
    exec /usr/bin/env \
      HCLOUD_TOKEN="$token" \
      REQUESTS_CA_BUNDLE="$gateway_ca" \
      SSL_CERT_FILE="$gateway_ca" \
      "$@"
    ;;
  github)
    token=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-github-personal-access-token -w 2>/dev/null) || {
      print -u2 "No GitHub token found in Keychain service mcp-github-personal-access-token"
      exit 78
    }
    exec /usr/bin/env GITHUB_PERSONAL_ACCESS_TOKEN="$token" "$@"
    ;;
  matrix)
    matrix_access_token=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-matrix-MATRIX_ACCESS_TOKEN -w 2>/dev/null) || exit 78
    matrix_data_dir=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-matrix-MATRIX_DATA_DIR -w 2>/dev/null) || exit 78
    matrix_homeserver_url=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-matrix-MATRIX_HOMESERVER_URL -w 2>/dev/null) || exit 78
    matrix_password=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-matrix-MATRIX_PASSWORD -w 2>/dev/null) || exit 78
    matrix_recovery_key=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-matrix-MATRIX_RECOVERY_KEY -w 2>/dev/null) || exit 78
    matrix_user_id=$(/usr/bin/security find-generic-password -a "$USER" -s mcp-matrix-MATRIX_USER_ID -w 2>/dev/null) || exit 78
    exec /usr/bin/env \
      MATRIX_ACCESS_TOKEN="$matrix_access_token" \
      MATRIX_DATA_DIR="$matrix_data_dir" \
      MATRIX_HOMESERVER_URL="$matrix_homeserver_url" \
      MATRIX_PASSWORD="$matrix_password" \
      MATRIX_RECOVERY_KEY="$matrix_recovery_key" \
      MATRIX_USER_ID="$matrix_user_id" \
      "$@"
    ;;
  *)
    print -u2 "Unknown credential source: $kind"
    exit 64
    ;;
esac
