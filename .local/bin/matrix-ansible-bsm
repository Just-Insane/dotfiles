#!/usr/bin/env bash
set -euo pipefail

REPO=${MATRIX_ANSIBLE_REPO:-$HOME/git/matrix-docker-ansible-deploy}
CONFIG_ROOT=${MDAD_CONFIG_ROOT:-$HOME/.config/mdad/matrix.cloudhub.social}
BSM_PROJECT_ID=${MDAD_BSM_PROJECT_ID:-7d21a45b-e63a-4177-9020-b48701662eda}
KEYCHAIN_ACCOUNT=${BWS_KEYCHAIN_ACCOUNT:-$USER}
KEYCHAIN_SERVICE=${BWS_KEYCHAIN_SERVICE:-bws-mcp-mac-studio-access-token}

usage() {
  cat >&2 <<'EOF'
Usage: matrix-ansible-bsm [--repo PATH] -- COMMAND [ARG...]

Examples:
  matrix-ansible-bsm -- just install-all
  matrix-ansible-bsm -- ansible-playbook -i inventory/hosts setup.yml --syntax-check

The normal Matrix vars.yml is a tracked, secret-free file. This wrapper reads
only the allowlisted values from the MDAD Bitwarden Secrets Manager project,
injects them into COMMAND's environment, and removes them from its own
environment on exit. No secret or private-key file is materialized.
EOF
}

if [[ ${1:-} == --repo ]]; then
  [[ $# -ge 3 ]] || { usage; exit 2; }
  REPO=$2
  shift 2
fi
[[ ${1:-} == -- ]] && shift
[[ $# -gt 0 ]] || { usage; exit 2; }

command -v bws >/dev/null || { echo 'bws is required' >&2; exit 1; }
command -v jq >/dev/null || { echo 'jq is required' >&2; exit 1; }
[[ -d "$REPO/.git" ]] || { echo "Matrix playbook repo not found: $REPO" >&2; exit 1; }

vars_source="$CONFIG_ROOT/vars.yml"
secret_keys_file="$CONFIG_ROOT/secret-keys.txt"
vars_file="$REPO/inventory/host_vars/matrix.cloudhub.social/vars.yml"
[[ -f "$vars_source" ]] || { echo "tracked MDAD vars missing: $vars_source" >&2; exit 1; }
[[ -f "$secret_keys_file" ]] || { echo "MDAD secret allowlist missing: $secret_keys_file" >&2; exit 1; }
[[ -e "$vars_file" && "$vars_file" -ef "$vars_source" ]] || {
  echo "inventory vars must link to tracked source: $vars_source" >&2
  exit 1
}

lock_dir="${TMPDIR:-/tmp}/matrix-ansible-bsm.$UID.lock"
mkdir "$lock_dir" 2>/dev/null || {
  echo 'another matrix-ansible-bsm command appears to be running' >&2
  exit 1
}

injected_keys=()
cleanup() {
  local key
  for key in "${injected_keys[@]}"; do
    unset "$key"
  done
  rmdir "$lock_dir" 2>/dev/null || true
  unset BWS_ACCESS_TOKEN
}
trap cleanup EXIT HUP INT TERM

if [[ -z ${BWS_ACCESS_TOKEN:-} ]]; then
  command -v security >/dev/null || {
    echo 'set BWS_ACCESS_TOKEN when macOS Keychain is unavailable' >&2
    exit 1
  }
  export BWS_ACCESS_TOKEN
  BWS_ACCESS_TOKEN=$(security find-generic-password \
    -a "$KEYCHAIN_ACCOUNT" -s "$KEYCHAIN_SERVICE" -w)
fi

secret_index=$(bws secret list)
while IFS= read -r key || [[ -n "$key" ]]; do
  [[ -n "$key" && "$key" != \#* ]] || continue
  [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || {
    echo "invalid environment key in $secret_keys_file: $key" >&2
    exit 1
  }
  id=$(jq -r --arg key "$key" --arg project "$BSM_PROJECT_ID" \
    '[.[] | select(.key == $key and .projectId == $project) | .id] | if length == 1 then .[0] else empty end' \
    <<<"$secret_index")
  [[ -n "$id" ]] || { echo "missing or duplicate MDAD BSM secret: $key" >&2; exit 1; }
  # The sentinel preserves trailing newlines in PEM/JSON values through command substitution.
  raw_value="$(bws secret get "$id" | jq -er '.value'; printf '\001')"
  value=${raw_value%$'\001'}
  export "$key=$value"
  injected_keys+=("$key")
  unset raw_value value
done <"$secret_keys_file"
unset secret_index id key

(cd "$REPO" && "$@")
