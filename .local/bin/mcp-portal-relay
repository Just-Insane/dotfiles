#!/bin/bash
set -euo pipefail

portal=${1:?usage: mcp-portal-relay read|actions}

case "$portal" in
  read)
    url='https://mcp-read.gauthier.id/mcp?codemode=search_and_execute'
    ;;
  actions)
    url='https://mcp-actions.gauthier.id/mcp?codemode=search_and_execute'
    ;;
  *)
    echo "unknown portal: $portal" >&2
    exit 2
    ;;
esac

cf_id=$(/usr/bin/security find-generic-password -w -a "$USER" -s mcp-cloudflare-access-client-id)
cf_secret=$(/usr/bin/security find-generic-password -w -a "$USER" -s mcp-cloudflare-access-client-secret)

exec /Users/evie/.nvm/versions/node/v24.14.1/bin/node \
  /Users/evie/.local/share/mcp-relay/node_modules/mcp-remote/dist/proxy.js \
  "$url" \
  --header "CF-Access-Client-Id: $cf_id" \
  --header "CF-Access-Client-Secret: $cf_secret"
