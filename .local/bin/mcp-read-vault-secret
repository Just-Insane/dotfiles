#!/bin/bash
set -euo pipefail

key=${1:?usage: mcp-read-vault-secret SECRET_KEY}
case "$key" in
  MCP_READ_CLOUDFLARE_ACCESS_CLIENT_ID|MCP_READ_CLOUDFLARE_ACCESS_CLIENT_SECRET|MCP_READ_CLOUDFLARE_ACCESS_TOKEN_ID) ;;
  *)
    echo "unsupported MCP Read runtime key: $key" >&2
    exit 2
    ;;
esac

vault_url=https://vault.service.control-plane:18211
vault_ca=$HOME/.config/personal-systems/vault/ca.pem
role_id=$(/usr/bin/security find-generic-password \
  -a "$USER" -s personal-systems-mac-vault-mcp-read-role-id -w)
secret_id=$(/usr/bin/security find-generic-password \
  -a "$USER" -s personal-systems-mac-vault-mcp-read-secret-id -w)

login_payload=$(/opt/homebrew/bin/jq -nc \
  --arg role_id "$role_id" --arg secret_id "$secret_id" \
  '{role_id:$role_id,secret_id:$secret_id}')
unset role_id secret_id
login_response=$(printf '%s' "$login_payload" | /usr/bin/curl \
  --silent --show-error --fail-with-body --request POST \
  --cacert "$vault_ca" \
  --resolve vault.service.control-plane:18211:127.0.0.1 \
  "$vault_url/v1/auth/approle/login" --data @-)
unset login_payload
vault_token=$(printf '%s' "$login_response" | \
  /opt/homebrew/bin/jq -erj '.auth.client_token')
unset login_response

cleanup() {
  /usr/bin/curl --silent --request POST --output /dev/null \
    --cacert "$vault_ca" \
    --resolve vault.service.control-plane:18211:127.0.0.1 \
    "$vault_url/v1/auth/token/revoke-self" \
    --config <(printf 'header = "X-Vault-Token: %s"\n' "$vault_token") || true
  unset vault_token
}
trap cleanup EXIT

contract=$(/usr/bin/curl --silent --show-error --fail-with-body \
  --cacert "$vault_ca" \
  --resolve vault.service.control-plane:18211:127.0.0.1 \
  "$vault_url/v1/kv/data/runtime/mcp-read/cloudflare-access" \
  --config <(printf 'header = "X-Vault-Token: %s"\n' "$vault_token"))
printf '%s' "$contract" | /opt/homebrew/bin/jq -erj --arg key "$key" \
  '.data.data[$key]'
unset contract
